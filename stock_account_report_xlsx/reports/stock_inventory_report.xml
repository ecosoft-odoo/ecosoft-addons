<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="report_stock_inventory_report_lines_header"
        inherit_id="stock_report_xlsx.report_stock_inventory_report_lines_header"
    >
        <xpath expr="//div[@id='header_lines']" position="inside">
            <div class="act_as_cell">Unit Price</div>
            <div class="act_as_cell">Subtotal</div>
        </xpath>
    </template>

    <template
        id="report_stock_inventory_report_lines"
        inherit_id="stock_report_xlsx.report_stock_inventory_report_lines"
    >
        <xpath expr="//div[@id='report_lines']" position="inside">
            <t t-set="unit_price" t-value="line.product_id.list_price" />
            <t t-set="subtotal" t-value="unit_price * line.quantity" />
            <div class="act_as_cell right">
                <span
                    t-out="unit_price"
                    t-options="{'widget': 'float', 'precision': 2}"
                />
            </div>
            <div class="act_as_cell right">
                <span
                    t-out="subtotal"
                    t-options="{'widget': 'float', 'precision': 2}"
                />
            </div>
        </xpath>
    </template>

    <template
        id="report_tax_report_total_lines"
        inherit_id="stock_report_xlsx.report_tax_report_total_lines"
    >
        <xpath expr="//div[hasclass('act_as_thead')]" position="inside">
            <t
                t-set="total_amount"
                t-value="sum([result.product_id.list_price * result.quantity for result in o.results])"
            />
            <div class="act_as_cell" />
            <div class="act_as_cell amount">
                <t
                    t-out="total_amount"
                    t-options="{'widget': 'float', 'precision': 2}"
                />
            </div>
        </xpath>
    </template>

</odoo>
