<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.line.application</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='integration']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="line_application">
                    <div class="o_setting_left_pane">
                        <field name="line_connect" />
                    </div>
                    <div class="o_setting_right_pane" id="line_connect_settings">
                        <label for="line_connect" />
                        <div class="text-muted">
                            Connect to LINE Application
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
