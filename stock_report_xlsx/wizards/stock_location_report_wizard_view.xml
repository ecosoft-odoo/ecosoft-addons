<odoo>
    <record id="stock_location_report_wizard_form" model="ir.ui.view">
        <field name="name">stock.location.report.wizard.form</field>
        <field name="model">stock.location.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group name="criteria">
                    <group colspan="4">
                        <field
                            name="company_id"
                            options="{'no_create_edit': True, 'no_open': True}"
                            groups="base.group_multi_company"
                        />
                        <field
                            name="location_ids"
                            options="{'no_create': True, 'no_create_edit': True}"
                            widget="many2many_tags"
                        />
                        <field
                            name="product_ids"
                            options="{'no_create': True, 'no_create_edit': True}"
                            widget="many2many_tags"
                        />
                    </group>
                </group>
                <footer>
                    <button
                        name="button_export_html"
                        string="View"
                        type="object"
                        default_focus="1"
                        class="oe_highlight"
                    />
                    or
                    <button
                        name="button_export_pdf"
                        string="Export PDF"
                        type="object"
                    />
                    or
                    <button
                        name="button_export_xlsx"
                        string="Export XLSX"
                        type="object"
                    />
                    or
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_stock_location_report" model="ir.actions.act_window">
        <field name="name">Inventory By Location</field>
        <field name="res_model">stock.location.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
