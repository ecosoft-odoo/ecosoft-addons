<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.request.document.account</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="request_document.res_config_settings_view_form_request_document"
        />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='request_docs']" position="inside">
                <setting
                    string="Vendor Bill State"
                    company_dependent="1"
                    help="Keep Vendor Bills in Draft or post them when their request reaches Done."
                >
                    <field name="request_document_bill_state" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
