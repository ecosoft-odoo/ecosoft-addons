<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_request_order_form" model="ir.ui.view">
        <field name="name">request.order.form.account</field>
        <field name="model">request.order</field>
        <field name="inherit_id" ref="request_document.view_request_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[@name='button_box']" position="inside">
                <button
                    type="object"
                    name="action_open_vendor_bills"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                    invisible="not vendor_bill_count"
                    groups="account.group_account_invoice"
                >
                    <field
                        name="vendor_bill_count"
                        widget="statinfo"
                        string="Vendor Bills"
                    />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
