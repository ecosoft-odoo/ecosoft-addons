<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <t
        t-name="line_chatbot.Message"
        t-inherit="mail.Message"
        t-inherit-mode="extension"
        owl="1"
    >
        <!-- TODO: No icon LINE, Is it posible to add icon LINE in chatter? -->
        <!-- Add icon in chatter before date -->
        <xpath expr="//div[contains(@class, 'o_Message_header')]/t[5]" position="after">
            <t t-if="threadView and messageView.message.message_type === 'line'">
                <Popover>
                    <span class="o_Message_notificationIconClickable mr-1">
                        <i
                            name="notificationIcon"
                            class="o_Message_notificationIcon fa fa-comments-o"
                        />
                    </span>
                    <t t-set="opened">
                        <NotificationPopover
                            notificationLocalIds="messageView.message.notifications.map(notification => notification.localId)"
                        />
                    </t>
                </Popover>
            </t>
        </xpath>
    </t>
</odoo>
