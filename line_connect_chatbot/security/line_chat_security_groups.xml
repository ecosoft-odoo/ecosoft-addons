<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="module_category_line_chat" model="ir.module.category">
        <field name="name">Chat - LINE Permission</field>
        <field name="description">Helps you handle your chat line.</field>
        <field name="sequence">30</field>
    </record>
    <record id="group_line_operater" model="res.groups">
        <field name="name">LINE Operater</field>
        <field name="category_id" ref="module_category_line_chat" />
    </record>
    <record id="group_line_manager" model="res.groups">
        <field name="name">LINE Manager</field>
        <field name="category_id" ref="module_category_line_chat" />
        <field
            name="implied_ids"
            eval="[(4, ref('line_connect_chatbot.group_line_operater'))]"
        />
        <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>
</odoo>
