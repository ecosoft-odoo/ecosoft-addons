<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_template_form_view_image_url" model="ir.ui.view">
        <field name="name">product.template.form.image.url</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']/.." position="before">
                <group string="Product Image" name="product_image_url_group">
                    <field
                        name="image_url"
                        placeholder="https://example.com/image.jpg"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
