<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="line_template_expense_approval" model="line.template">
        <field name="name">Flex: Expense Approval</field>
        <field name="template_model" ref="hr_expense.model_hr_expense_sheet" />
        <field name="template_default" eval="1" />
        <field name="template_type">dynamic</field>
        <field name="alt_text">%(number)s requires approval.</field>
        <field name="dynamic_data">
            {
                'number': record.number,
                'sheet_name': record.name,
                'employee_name': record.employee_id.name,
                'today_datetime': today_datetime,
                'total_amount': '%s %s' % ("{:,.2f}".format(record.total_amount), record.currency_id.symbol),
                'model': record._name,
                'res_id': record.id,
                'method': '_process_approval',
                'loop_line_detail': record.loop_line_detail()
            }
        </field>
        <field name="json_data">
            {
                "type": "bubble",
                "size": "giga",
                "body": {
                    "type": "box",
                    "layout": "vertical",
                    "contents": [
                        {
                            "type": "text",
                            "text": "%(number)s",
                            "weight": "bold",
                            "size": "xl"
                        },
                        {
                            "type": "box",
                            "layout": "vertical",
                            "margin": "lg",
                            "spacing": "sm",
                            "contents": [
                                {
                                    "type": "box",
                                    "layout": "baseline",
                                    "spacing": "sm",
                                    "contents": [
                                        {
                                            "type": "text",
                                            "text": "%(sheet_name)s",
                                            "wrap": true,
                                            "color": "#666666",
                                            "size": "sm",
                                            "flex": 4
                                        }
                                    ]
                                },
                                {
                                    "type": "box",
                                    "layout": "baseline",
                                    "spacing": "sm",
                                    "contents": [
                                        {
                                            "type": "text",
                                            "text": "Employee",
                                            "color": "#aaaaaa",
                                            "size": "xs",
                                            "flex": 1,
                                            "margin": "none"
                                        },
                                        {
                                            "type": "text",
                                            "text": "%(employee_name)s",
                                            "wrap": true,
                                            "color": "#666666",
                                            "size": "sm",
                                            "flex": 4
                                        }
                                    ]
                                },
                                {
                                    "type": "box",
                                    "layout": "baseline",
                                    "spacing": "sm",
                                    "contents": [
                                        {
                                            "type": "text",
                                            "text": "Time",
                                            "color": "#aaaaaa",
                                            "size": "sm",
                                            "flex": 1
                                        },
                                        {
                                            "type": "text",
                                            "text": "%(today_datetime)s",
                                            "wrap": true,
                                            "color": "#666666",
                                            "size": "sm",
                                            "flex": 4
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "type": "separator",
                            "margin": "xxl"
                        },
                        {
                            "type": "box",
                            "layout": "horizontal",
                            "margin": "md",
                            "spacing": "sm",
                            "contents": [
                            {
                                "type": "box",
                                "layout": "horizontal",
                                "spacing": "xs",
                                "contents": [
                                {
                                    "type": "text",
                                    "text": "Product",
                                    "size": "xs",
                                    "flex": 1,
                                    "margin": "none",
                                    "contents": [],
                                    "color": "#aaaaaa"
                                }
                                ]
                            },
                            {
                                "type": "box",
                                "layout": "horizontal",
                                "spacing": "xs",
                                "contents": [
                                {
                                    "type": "text",
                                    "text": "Description",
                                    "size": "xs",
                                    "flex": 1,
                                    "margin": "none",
                                    "contents": [],
                                    "color": "#aaaaaa"
                                }
                                ]
                            },
                            {
                                "type": "box",
                                "layout": "horizontal",
                                "spacing": "sm",
                                "contents": [
                                {
                                    "type": "text",
                                    "text": "Subtotal",
                                    "size": "sm",
                                    "flex": 1,
                                    "align": "end",
                                    "color": "#aaaaaa"
                                }
                                ]
                            }
                            ]
                        },
                        {
                            "type": "separator",
                            "margin": "md"
                        },
                        %(loop_line_detail)s,
                        {
                            "type": "separator",
                            "margin": "xxl"
                        },
                        {
                            "type": "box",
                            "layout": "vertical",
                            "margin": "lg",
                            "spacing": "sm",
                            "contents": [
                                {
                                    "type": "box",
                                    "layout": "horizontal",
                                    "spacing": "sm",
                                    "contents": [
                                        {
                                            "type": "text",
                                            "text": "Total",
                                            "size": "sm",
                                            "flex": 1
                                        },
                                        {
                                            "type": "text",
                                            "text": "%(total_amount)s",
                                            "wrap": true,
                                            "size": "sm",
                                            "flex": 5,
                                            "align": "end"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                "footer": {
                    "type": "box",
                    "layout": "vertical",
                    "margin": "lg",
                    "spacing": "sm",
                    "contents": [
                        {
                            "type": "button",
                            "action": {
                                "type": "postback",
                                "label": "DETAIL",
                                "data": "action=detail&amp;model=%(model)s&amp;res_id=%(res_id)s&amp;method=%(method)s"
                            },
                            "margin": "xxl",
                            "flex": 6,
                            "style": "secondary",
                            "height": "sm"
                        },
                        {
                            "type": "separator",
                            "margin": "xxl"
                        },
                        {
                            "type": "box",
                            "layout": "horizontal",
                            "spacing": "sm",
                            "contents": [
                                {
                                    "type": "button",
                                    "style": "primary",
                                    "height": "sm",
                                    "action": {
                                        "type": "postback",
                                        "label": "APPROVE",
                                        "data": "action=approve&amp;model=%(model)s&amp;res_id=%(res_id)s&amp;method=%(method)s",
                                        "displayText": "approve"
                                    },
                                    "flex": 6
                                },
                                {
                                    "type": "button",
                                    "style": "secondary",
                                    "height": "sm",
                                    "action": {
                                        "type": "postback",
                                        "label": "REJECT",
                                        "data": "action=reject&amp;model=%(model)s&amp;res_id=%(res_id)s&amp;method=%(method)s",
                                        "displayText": "reject"
                                    },
                                    "color": "#FAA0A0",
                                    "flex": 6,
                                    "margin": "xxl"
                                }
                            ]
                        }
                    ]
                }
            }
        </field>
    </record>
</odoo>
