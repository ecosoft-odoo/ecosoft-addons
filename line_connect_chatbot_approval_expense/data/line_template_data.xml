<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="line_template_expense_approval" model="line.template">
        <field name="name">Flex: Expense Approval</field>
        <field name="template_model" ref="hr_expense.model_hr_expense_sheet" />
        <field name="template_default" eval="1" />
        <field name="template_type">dynamic</field>
        <field name="alt_text">You have a new approval request %(number)s.</field>
        <field name="dynamic_data">
            {
                'number': record.number,
                'employee_name': record.employee_id.name,
                'today_datetime': today_datetime,
                'sheet_name': record.name,
                'loop_line_detail': record.loop_line_detail(),
                'loop_attachment': record.loop_attachment(),
                'total_amount': '%s %s' % ("{:,.2f}".format(record.total_amount), record.currency_id.symbol),
                'model': record._name,
                'res_id': record.id,
                'method': '_process_approval',
            }
        </field>
        <field name="json_data">
        {
            "type": "bubble",
            "size": "giga",
            "header": {
                "type": "box",
                "layout": "vertical",
                "contents": [
                    {
                        "type": "text",
                        "text": "Approval Request",
                        "weight": "bold",
                        "size": "lg",
                        "color": "#ffffff"
                    }
                ],
                "backgroundColor": "#0367D3",
                "paddingAll": "20px"
            },
            "body": {
                "type": "box",
                "layout": "vertical",
                "spacing": "md",
                "contents": [
                    {
                        "type": "box",
                        "layout": "baseline",
                        "contents": [
                            {
                                "type": "text",
                                "text": "Document:",
                                "weight": "bold",
                                "size": "sm",
                                "color": "#555555",
                                "flex": 1
                            },
                            {
                                "type": "text",
                                "text": "%(number)s",
                                "size": "sm",
                                "color": "#111111",
                                "margin": "md",
                                "flex": 2
                            }
                        ]
                    },
                    {
                        "type": "box",
                        "layout": "baseline",
                        "contents": [
                            {
                                "type": "text",
                                "text": "Requester:",
                                "weight": "bold",
                                "size": "sm",
                                "color": "#555555",
                                "flex": 1
                            },
                            {
                                "type": "text",
                                "text": "%(employee_name)s",
                                "size": "sm",
                                "color": "#111111",
                                "margin": "md",
                                "flex": 2
                            }
                        ]
                    },
                    {
                        "type": "box",
                        "layout": "baseline",
                        "contents": [
                            {
                                "type": "text",
                                "text": "Request Time:",
                                "weight": "bold",
                                "size": "sm",
                                "color": "#555555",
                                "flex": 2
                            },
                            {
                                "type": "text",
                                "text": "%(today_datetime)s",
                                "size": "sm",
                                "color": "#111111",
                                "margin": "md",
                                "flex": 3
                            }
                        ]
                    },
                    {
                        "type": "separator"
                    },
                    {
                        "type": "text",
                        "text": "Summary:",
                        "weight": "bold",
                        "size": "sm",
                        "color": "#555555"
                    },
                    {
                        "type": "text",
                        "text": "%(sheet_name)s",
                        "size": "sm",
                        "color": "#111111",
                        "wrap": true
                    },
                    {
                        "type": "box",
                        "layout": "vertical",
                        "spacing": "sm",
                        "contents": [
                            {
                                "type": "box",
                                "layout": "baseline",
                                "contents": [
                                    {
                                        "type": "text",
                                        "text": "Line Items:",
                                        "weight": "bold",
                                        "size": "sm",
                                        "color": "#555555"
                                    }
                                ]
                            },
                            %(loop_line_detail)s,
                            {
                                "type": "separator"
                            },
                            {
                                "type": "box",
                                "layout": "baseline",
                                "contents": [
                                    {
                                        "type": "text",
                                        "text": "Total Amount:",
                                        "weight": "bold",
                                        "size": "sm",
                                        "color": "#555555"
                                    },
                                    {
                                        "type": "text",
                                        "text": "%(total_amount)s",
                                        "size": "sm",
                                        "color": "#111111",
                                        "margin": "md",
                                        "align": "end"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "separator"
                    },
                    {
                        "type": "box",
                        "layout": "vertical",
                        "spacing": "sm",
                        "contents": [
                            {
                                "type": "text",
                                "text": "Attachment:",
                                "weight": "bold",
                                "size": "sm",
                                "color": "#555555"
                            },
                            %(loop_attachment)s
                        ]
                    }
                ]
            },
            "footer": {
                "type": "box",
                "layout": "horizontal",
                "spacing": "sm",
                "contents": [
                    {
                        "type": "button",
                        "style": "primary",
                        "color": "#28A745",
                        "action": {
                            "type": "postback",
                            "label": "Approve",
                            "data": "action=approve&amp;model=%(model)s&amp;res_id=%(res_id)s&amp;method=%(method)s"
                        }
                    },
                    {
                        "type": "button",
                        "style": "primary",
                        "color": "#DC3545",
                        "action": {
                            "type": "postback",
                            "label": "Reject",
                            "data": "action=reject&amp;model=%(model)s&amp;res_id=%(res_id)s&amp;method=%(method)s"
                        }
                    }
                ]
            }
        }
        </field>
    </record>
</odoo>
