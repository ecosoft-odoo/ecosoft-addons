<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="zort_product_search_view" model="ir.ui.view">
        <field name="name">zort.product.search</field>
        <field name="model">zort.product</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="id_zort_product" />
                <field name="sku" />
            </search>
        </field>
    </record>
    <record id="view_zort_product_form" model="ir.ui.view">
        <field name="name">zort.product.form</field>
        <field name="model">zort.product</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group name="product_info" string="Product Information">
                            <field name="name" />
                            <field name="id_zort_product" />
                            <field name="sku" />
                            <field name="unit_text" />
                            <field name="image_url" widget="url" />
                            <field name="product_id" readonly="1" />
                            <field name="description" />
                        </group>
                        <group name="pricing_info" string="Pricing Information">
                            <field name="sell_price" />
                            <field name="purchase_price" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_zort_product_list" model="ir.ui.view">
        <field name="name">zort.product.list</field>
        <field name="model">zort.product</field>
        <field name="arch" type="xml">
            <list>
                <field name="id_zort_product" />
                <field name="name" />
                <field name="sku" />
                <field name="product_id" />
                <field name="sell_price" />
                <field name="purchase_price" />
            </list>
        </field>
    </record>

    <record id="action_zort_product" model="ir.actions.act_window">
        <field name="name">Zort Products</field>
        <field name="res_model">zort.product</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="zort_product_search_view" />
    </record>
    <menuitem
        id="menu_zort_product"
        name="Zort Products"
        parent="stock.menu_stock_inventory_control"
        action="action_zort_product"
    />
</odoo>
