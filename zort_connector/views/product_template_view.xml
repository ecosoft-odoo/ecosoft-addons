<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_template_only_form_view" model="ir.ui.view">
        <field name="name">product.template.only.form.view.inherit.sale</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="sync_with_zort" invisible="1" />
                <button
                    name="action_create_product_on_zort"
                    type="object"
                    string="Create to Zort"
                    class="oe_highlight"
                    invisible="not sync_with_zort or is_created_on_zort"
                />
                <button
                    name="action_update_product_to_zort"
                    type="object"
                    string="Update to Zort"
                    class="btn-info"
                    invisible="not is_created_on_zort"
                />
                <button
                    name="action_update_qty_to_zort"
                    type="object"
                    string="Update Quantity to Zort"
                    class="btn-info"
                    invisible="not is_created_on_zort"
                    help="Update the quantity of this product on Zort"
                />
                <button
                    name="action_fetch_and_update_image_from_zort"
                    type="object"
                    string="Fetch Image from Zort"
                    class="btn-info"
                />
            </xpath>
            <xpath
                expr="//page[@name='general_information']/group/group[@name='group_standard_price']"
                position="inside"
            >
                <field name="sync_with_zort" readonly="is_created_on_zort" />
                <field name="zort_product_id" readonly="not sync_with_zort" />
            </xpath>
        </field>
    </record>
</odoo>
