<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_template_only_form_view" model="ir.ui.view">
        <field name="name">product.template.only.form.view.inherit.sale</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="sync_with_zort" invisible="1" />
                <button
                    name="action_update_create_product_on_zort"
                    type="object"
                    string="Update/Create product to Zort"
                    class="oe_highlight"
                    invisible="not sync_with_zort"
                />
            </xpath>
            <xpath
                expr="//page[@name='general_information']/group/group[@name='group_standard_price']"
                position="inside"
            >
                <field
                    name="sync_with_zort"
                    string="Sync with Zort"
                    help="Enable synchronization of this product with Zort"
                />
            </xpath>
        </field>
    </record>
</odoo>
