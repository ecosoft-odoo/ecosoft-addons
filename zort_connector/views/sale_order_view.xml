<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="inherit_sale_order_view" model="ir.ui.view">
        <field name="name">sale.order.inherit.zort.connector</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='customer_signature']" position="after">
                <page name="zort_order_info" string="Zort Order Info" id="zort_order_info">
                    <group>
                        <field name="is_zort_order" string="Is Zort Order"/>
                        <field name="zort_order_id" string="Order ID"/>
                        <field name="zort_order_number" string="Order Number"/>
                        <field name="zort_order_status" string="Order Status"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
