<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_line_approval_wizard" model="ir.ui.view">
        <field name="name">Approval by LINE</field>
        <field name="model">line.approval.wizard</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Approval by LINE">
                <group>
                    <field name="model" readonly="1" />
                    <field
                        name="template_id"
                        domain="[('template_model', 'in', [False, model])]"
                    />
                    <field
                        name="partner_approval"
                        domain="[('line_access_token', '!=', False)]"
                    />
                </group>
                <footer>
                    <button
                        name="action_approval_line"
                        string="Send Approval"
                        type="object"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" class="btn-default" />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_view_approval_line" model="ir.actions.act_window">
        <field name="name">Approval by LINE</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">line.approval.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
