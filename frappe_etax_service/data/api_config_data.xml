<odoo noupdate="1">
    <!-- Invoice -->
    <record id="api_etax_invoice_frappe" model="api.config">
        <field name="name">Frappe - eTax Invoice</field>
        <field name="code">FRAPPE_ETAX_SIGN</field>
        <field name="model_id" ref="account.model_account_move" />
        <field name="endpoint_url" eval="False" />
        <field
            name="route_path"
        >/api/method/etax_inet.api.etax.sign_etax_document</field>
        <field name="endpoint_system">external</field>
        <field name="auth_required">False</field>
        <field name="auth_method">static_token</field>
        <field name="auth_token" eval="False" />
        <field name="save_log">1</field>
        <field name="api_type">rest_api</field>
        <field name="is_form_data">1</field>
        <field name="method">post</field>
        <field name="headers">{"Authorization": f"token {auth_token}"}</field>
        <field name="python_code">
            {
                "doc_data": rec._get_etax_document_data(),
                "form_type": form_type,  # odoo or frappe
                # odoo's report name or frappe's print format
                "form_name": form_name,
                "pdf_content": pdf_content,
            }
        </field>
    </record>
