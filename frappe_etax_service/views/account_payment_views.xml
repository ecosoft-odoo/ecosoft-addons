<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_payment_tree" model="ir.ui.view">
        <field name="name">account.view.account.payment.tree</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field
                    name="etax_status"
                    widget="badge"
                    decoration-success="etax_status == 'success'"
                    decoration-info="etax_status == 'replace'"
                    decoration-danger="etax_status == 'error'"
                    decoration-warning="etax_status == 'processing'"
                    optional="show"
                />
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_form" model="ir.ui.view">
        <field name="name">view.account.payment.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="l10n_th_account_tax.view_account_payment_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="after">
                <field name="etax_status" invisible="1" />
                <div
                    groups="account.group_account_invoice,account.group_account_readonly"
                    class="text-right alert alert-success"
                    role="alert"
                    invisible="etax_status != 'success'"
                >
                    Digitally signed eTax invoice
                </div>
                <div
                    groups="account.group_account_invoice,account.group_account_readonly"
                    class="text-right alert alert-info"
                    role="alert"
                    invisible="etax_status != 'replace'"
                >
                    This eTax document has been replaced
                </div>
            </xpath>
            <xpath expr="//button[@name='mark_as_sent']" position="after">
                <button
                    string='e-Tax Invoice'
                    name="button_etax_invoices"
                    type="object"
                    class="btn-info"
                    invisible="etax_status in ['success', 'processing'] or state != 'paid'"
                />
                <button
                    name="action_open_replacement_wizard"
                    string="Create Replacement Receipt e-Tax"
                    type="object"
                    invisible="etax_status != 'success' or state != 'paid'"
                />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    class="oe_stat_button"
                    icon="fa-list-alt"
                    type="object"
                    name="action_view_api_logs"
                    invisible="api_log_count == 0"
                >
                    <field name="api_log_count" widget="statinfo" string="API Logs" />
                </button>
            </xpath>
            <xpath expr="//group[@name='main_group']" position="after">
                <group name="etax_info" string="e-Tax">
                    <group>
                        <field name="etax_doctype_id" string="Doctype" readonly="1" />
                        <field
                            name="etax_status"
                            string="Status"
                            widget="badge"
                            decoration-success="etax_status == 'success'"
                            decoration-info="etax_status == 'replace'"
                            decoration-danger="etax_status == 'error'"
                            decoration-warning="etax_status == 'processing'"
                        />
                        <field
                            name="etax_error_code"
                            string="Error Code"
                            readonly="1"
                        />
                    </group>
                    <group>
                        <field name="etax_doctype_code" string="Doctype Code" />
                        <field
                            name="etax_transaction_code"
                            string="Transaction Code"
                            readonly="1"
                        />
                        <field
                            name="etax_error_message"
                            string="Error Message"
                            readonly="1"
                        />
                    </group>
                </group>
                <group string="Additional Information">
                    <group>
                        <field
                            name="replaced_receipt_id"
                            invisible="not replaced_receipt_id"
                        />
                        <field
                            name="create_purpose_code"
                            readonly="1"
                            required="replaced_receipt_id"
                        />
                    </group>
                    <group>
                        <field
                            name="create_purpose"
                            readonly="1"
                            required="replaced_receipt_id"
                        />
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
