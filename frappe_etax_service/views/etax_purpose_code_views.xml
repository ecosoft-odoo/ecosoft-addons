<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_etax_purpose_code_form" model="ir.ui.view">
        <field name="name">view.etax.purpose.code.form</field>
        <field name="model">etax.purpose.code</field>
        <field name="arch" type="xml">
            <form string="Purpose Code">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="code" />
                            <field name="reason" />
                        </group>
                        <group>
                            <field
                                name="etax_doctype_code_ids"
                                widget="many2many_tags"
                            />
                        </group>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <record id="view_etax_purpose_code_list" model="ir.ui.view">
        <field name="name">view.etax.purpose.code.list</field>
        <field name="model">etax.purpose.code</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="code" />
                <field name="reason" />
                <field
                    name="etax_doctype_code_ids"
                    widget="many2many_tags"
                    optional="show"
                />
            </list>
        </field>
    </record>
    <record id="view_etax_purpose_code_search" model="ir.ui.view">
        <field name="name">view.etax.purpose.code.search</field>
        <field name="model">etax.purpose.code</field>
        <field name="arch" type="xml">
            <search string="Purpose Code">
                <field name="name" />
                <field name="code" />
                <field name="etax_doctype_code_ids" />
                <group expand="0" string="Group By">
                    <filter
                        name="etax_doctype_code_groupby"
                        string="Doctype Code"
                        context="{'group_by': 'etax_doctype_code_ids'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="action_etax_purpose_code" model="ir.actions.act_window">
        <field name="name">Purpose Code</field>
        <field name="res_model">etax.purpose.code</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="sub_purpose_code_menu"
        parent="frappe_etax_service.etax_service_menu"
        action="action_etax_purpose_code"
        sequence="10"
    />
</odoo>
