<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="etax_multi_credit_note_wizard_form" model="ir.ui.view">
        <field name="name">etax.multi.credit.note.wizard.form</field>
        <field name="model">etax.multi.credit.note.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Credit Note (Multi Reference)">
                <field name="company_id" invisible="1" />
                <field name="currency_id" invisible="1" />
                <field name="invoice_ids" invisible="1" />
                <field name="available_product_ids" invisible="1" />
                <group>
                    <group>
                        <field name="partner_id" />
                        <field
                            name="product_ids"
                            widget="many2many_tags"
                            placeholder="All products"
                            options="{'no_create': True}"
                        />
                        <field name="credit_method" widget="radio" />
                        <field
                            name="credit_percent"
                            invisible="credit_method != 'percent'"
                        />
                        <field
                            name="total_amount"
                            invisible="credit_method != 'amount'"
                        />
                        <div colspan="2">
                            <button
                                name="action_calculate"
                                type="object"
                                string="Calculate"
                                class="btn-secondary"
                                icon="fa-calculator"
                            />
                        </div>
                    </group>
                    <group>
                        <field name="date" />
                        <field
                            name="purpose_code_id"
                            options="{'no_create': True, 'no_open': True}"
                        />
                        <field name="reason" />
                        <field name="name" placeholder="Invoice line label" />
                        <field name="allocated_amount" />
                    </group>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="0">
                        <field name="currency_id" column_invisible="1" />
                        <field
                            name="invoice_line_id"
                            column_invisible="1"
                            force_save="1"
                        />
                        <field name="invoice_id" />
                        <field name="invoice_date" optional="show" />
                        <field name="product_id" />
                        <field name="name" optional="show" />
                        <field name="amount_untaxed" sum="Total" />
                        <field name="credited_amount" optional="hide" />
                        <field name="remaining_amount" />
                        <field name="credit_amount" sum="Total" />
                    </list>
                </field>
                <footer>
                    <button
                        name="action_create"
                        type="object"
                        string="Create Credit Note"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button special="cancel" string="Cancel" data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_etax_multi_credit_note_wizard" model="ir.actions.act_window">
        <field name="name">Create Credit Note (Multi Reference)</field>
        <field name="res_model">etax.multi.credit.note.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move" />
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_invoice'))]" />
    </record>
</odoo>
