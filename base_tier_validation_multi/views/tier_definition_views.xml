<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="tier_definition_view_form_multi" model="ir.ui.view">
        <field name="name">tier.definition.form.multi</field>
        <field name="model">tier.definition</field>
        <field name="inherit_id" ref="base_tier_validation.tier_definition_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='options']/group" position="inside">
                <group name="multi_validate">
                    <field name="allow_multi_validate" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
