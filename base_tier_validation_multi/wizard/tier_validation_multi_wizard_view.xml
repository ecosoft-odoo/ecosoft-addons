<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_tier_validation_multi_wizard_form" model="ir.ui.view">
        <field name="name">tier.validation.multi.wizard.form</field>
        <field name="model">tier.validation.multi.wizard</field>
        <field name="arch" type="xml">
            <form string="Multi Tier Validation">
                <group>
                    <field name="res_model" invisible="1" />
                    <field name="res_ids" invisible="1" />
                    <field name="validate_reject" invisible="1" />
                    <field name="record_count" readonly="1" />
                    <field name="has_comment" invisible="1" />
                    <field
                        name="comment"
                        invisible="not has_comment"
                        required="has_comment"
                    />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Request Validation"
                        class="btn-primary"
                        invisible="validate_reject != 'request'"
                    />
                    <button
                        name="action_validate"
                        type="object"
                        string="Validate"
                        class="btn-primary"
                        invisible="validate_reject == 'request'"
                    />
                    <button
                        name="action_reject"
                        type="object"
                        string="Reject"
                        class="btn-danger"
                        invisible="validate_reject == 'request'"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
